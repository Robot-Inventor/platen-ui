{
  "name": "platen-ui",
  "version": "0.2.0",
  "description": "Styled Base UI components for professional software",
  "homepage": "https://github.com/Robot-Inventor/platen-ui#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/platen-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/platen-ui.git"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "type": "module",
  "publishConfig": {
    "provenance": true
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/theme.js",
      "types": "./dist/theme.d.ts"
    },
    "./Accordion": {
      "import": "./dist/components/Accordion.js",
      "types": "./dist/components/Accordion.d.ts"
    },
    "./Button": {
      "import": "./dist/components/Button.js",
      "types": "./dist/components/Button.d.ts"
    },
    "./Input": {
      "import": "./dist/components/Input.js",
      "types": "./dist/components/Input.d.ts"
    },
    "./Progress": {
      "import": "./dist/components/Progress.js",
      "types": "./dist/components/Progress.d.ts"
    },
    "./Select": {
      "import": "./dist/components/Select.js",
      "types": "./dist/components/Select.d.ts"
    },
    "./Switch": {
      "import": "./dist/components/Switch.js",
      "types": "./dist/components/Switch.d.ts"
    },
    "./Toast": {
      "import": "./dist/components/Toast.js",
      "types": "./dist/components/Toast.d.ts"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.styles.js",
    "**/theme.js"
  ],
  "scripts": {
    "lint": "tsc --noEmit && knip && oxlint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build": "tsdown --minify",
    "ci:version": "changeset version",
    "ci:publish": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^0.5.1",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.41.0",
    "oxc-transform-react": "^0.154.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.55.0"
  }
}
